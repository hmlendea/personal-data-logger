{
  "personalLogManagerSettings": {
    "baseUrl": "[[PERSONAL_LOG_MANAGER_BASE_URL]]",
    "apiKey": "[[PERSONAL_LOG_MANAGER_API_KEY]]",
    "hmacSharedSecretKey": "[[PERSONAL_LOG_MANAGER_HMAC_SIGNING_KEY]]",
    "clientId": "[[PERSONAL_DATA_LOGGER_CLIENT_ID]]"
  },
  "imapSettings": {
    "server": "[[IMAP_SERVER]]",
    "port": "[[IMAP_PORT]]",
    "username": "[[IMAP_USERNAME]]",
    "password": "[[IMAP_PASSWORD]]",
    "maxEmailAge": 1800
  },
  "personalSettings": {
    "employerName": "[[EMPLOYER_NAME]]"
  },
  "aliExpressSettings": {
    "emailAddress": "[[ALIEXPRESS_EMAIL_ADDRESS]]"
  },
  "profiBotServerSettings": {
    "accountName": "[[PROFI_BOT_SERVER_ACCOUNT_NAME]]",
    "scheduledHours": "[[PROFI_BOT_SERVER_SCHEDULED_HOURS]]",
    "accountsEndpoint": "/Users/{username}/accounts",
    "baseUrl": "[[PROFI_BOT_SERVER_BASE_URL]]",
    "clientId": "[[PERSONAL_DATA_LOGGER_CLIENT_ID]]",
    "hmacSharedSecretKey": "[[PROFI_BOT_SERVER_HMAC_SHARED_SECRET_KEY]]",
    "userApiKey": "[[PROFI_BOT_SERVER_USER_API_KEY]]",
    "username": "[[PROFI_BOT_SERVER_USERNAME]]"
  },
  "nuciLoggerSettings": {
      "minimumLevel": "Debug",
      "logFilePath": "logfile.log",
      "isFileOutputEnabled": true
  }
